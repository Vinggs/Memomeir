# ==============================================================================
# Memomeir - Environment Configuration
# ==============================================================================

# PostgreSQL Connection String
# Example for Neon, Supabase, Railway, or local PostgreSQL:
# postgresql://postgres:password@localhost:5432/memomeir
# If left blank, Memomeir will use the built-in resilient local storage engine
# that mirrors the exact PostgreSQL schema and behavior.
DATABASE_URL=

# Port for the Memomeir server
PORT=4000

# WhatsApp Webhook Security Secret (Optional: for Bearer or query verification)
WHATSAPP_WEBHOOK_SECRET=antigravity_secret_2026
